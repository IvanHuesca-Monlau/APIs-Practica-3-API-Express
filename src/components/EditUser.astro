<div>
  <div class="bg-white rounded-lg shadow-md p-6 top-8">
    <h2 class="text-xl font-semibold text-slate-800 mb-4">Editar usuario</h2>
    <form id="formEditar" class="space-y-4">
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1">ID</label>
        <div class="flex gap-2">
          <input
            type="number"
            id="editId"
            placeholder="Introduce el ID de usuario a editar"
            class="flex-1 px-3 py-2 border border-slate-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
          />
          <button
            type="button"
            onclick="window.cargarDatosParaEditar()"
            class="bg-slate-600 hover:bg-slate-700 text-white px-4 py-2 rounded-md transition"
          >
            Cargar
          </button>
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1"
          >Nombre</label
        >
        <input
          type="text"
          id="editFirst_name"
          placeholder="Introduce aquí el nombre"
          class="w-full px-3 py-2 border border-slate-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1"
          >Apellido</label
        >
        <input
          type="text"
          id="editLast_name"
          placeholder="Introduce aquí los apellidos"
          class="w-full px-3 py-2 border border-slate-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1"
          >Usuario</label
        >
        <input
          type="text"
          id="editUsername"
          placeholder="Introduce aquí el nombre de usuario"
          class="w-full px-3 py-2 border border-slate-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1"
          >Correo electrónico</label
        >
        <input
          type="email"
          id="editEmail"
          placeholder="Introduce aquí el correo electrónico"
          class="w-full px-3 py-2 border border-slate-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
      </div>
      <button
        type="submit"
        id="btnEditar"
        class="w-full bg-amber-600 hover:bg-amber-700 text-white font-medium py-2 rounded-md transition disabled:opacity-50 disabled:cursor-not-allowed"
        disabled
      >
        Editar usuario
      </button>
    </form>
  </div>
</div>
