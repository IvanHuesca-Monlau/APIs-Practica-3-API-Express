<div class="bg-white rounded-lg shadow-md p-6">
  <h2 class="text-xl font-semibold text-slate-800 mb-1">
    Buscar usuario por ID
  </h2>
  <div class="flex gap-2 mt-4">
    <input
      type="number"
      id="searchId"
      placeholder="ID"
      class="flex-1 px-3 py-2 border border-slate-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
    />
    <button
      onclick="window.buscarPorId()"
      class="bg-slate-600 hover:bg-slate-700 text-white px-4 py-2 rounded-md transition"
    >
      Buscar
    </button>
  </div>
</div>
